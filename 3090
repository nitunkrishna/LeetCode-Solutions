class Solution {
public:
    int maximumLengthSubstring(string s) {
        vector<int>v;
        map<char, int>freq;
        int res=0;
        for(int i=0; i<s.length(); i++)
        {
            v.clear();
            freq.clear();
            for(int j=i; j<s.length(); j++)
            {
                v.push_back(s[j]);
                freq[s[j]]++;
                if (freq[s[j]]>2)
                {
                    v.clear();
                    freq.clear();
                    break;
                }
                res=max(res, (int)v.size());
            }
        }
        return res;
    }
};
