class Solution {
public:
    int maxProduct(int n) {
        int max1, max2;
        vector<int>v;
        while(n>0)
        {
            int dig=n%10;
            v.push_back(dig);
            n/=10;
        }
        auto it=max_element(v.begin(), v.end());
        max1=*it;
        v.erase(it);
        max2=*max_element(v.begin(), v.end());
        return (max1*max2);
    }
};
